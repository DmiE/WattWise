---
import Layout from "@/layouts/Layout.astro";
import PlanView from "@/components/plan/PlanView";
import { createClient } from "@/lib/supabase";
import { getActivePlan, getPlanWithSessions, type PlanWithSessions } from "@/lib/services/plan";

const { user } = Astro.locals;

// Fetch the active plan (with its sessions) server-side. When the user has no
// active plan, `plan` stays null and the island generates one on load. The
// generate endpoint reloads on success, so this server path always supplies the
// full plan + sessions to render.
let plan: PlanWithSessions | null = null;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      const active = await getActivePlan(supabase, user.id);
      if (active) {
        plan = await getPlanWithSessions(supabase, active.id);
      }
    } catch {
      // A transient read failure shouldn't 500 the whole dashboard (and lock
      // the user out of sign-out). Leave `plan` null: the island attempts
      // generation, and the generate route — which is idempotent — returns the
      // existing plan or a friendly error. Mirrors generate.ts:45-49.
      plan = null;
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen flex-col items-center p-4">
    <div class="flex w-full max-w-2xl items-center justify-between py-4 text-white">
      <span class="text-sm text-blue-100/70">
        <span class="font-semibold text-white">{user?.email}</span>
      </span>
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
    <div class="flex w-full flex-1 items-start justify-center pt-4">
      <PlanView client:load plan={plan} />
    </div>
  </div>
</Layout>
