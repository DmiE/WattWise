SUPABASE_URL=###
SUPABASE_KEY=###

# AI gateway — OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys
# Production: `npx wrangler secret put OPENROUTER_API_KEY` + a Cloudflare var for OPENROUTER_MODEL.
OPENROUTER_API_KEY=###
# Verified paid model (good plan quality). Free fallback for local dev: openai/gpt-oss-20b:free
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
